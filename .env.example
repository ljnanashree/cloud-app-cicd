# Flask Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
PORT=5000

# Database Configuration
# For local development with SQLite, leave DATABASE_URL blank or set to sqlite:///local.db
# DATABASE_URL=sqlite:///local.db
# For Cloud PostgreSQL (Render / Neon / Supabase):
# DATABASE_URL=postgres://user:password@host.oregon-postgres.render.com:5432/dbname?sslmode=require
DATABASE_URL=

# App Metadata
APP_NAME=CloudPulse
APP_VERSION=1.0.0
